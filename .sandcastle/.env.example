# ═══════════════════════════════════════════════════════════════════════════
# Copy to .sandcastle/.env and fill in. .env is gitignored — never commit it.
# ═══════════════════════════════════════════════════════════════════════════

# ── Auth ─────────────────────────────────────────────────────────────────
# Claude Code OAuth token — run `claude setup-token` on your host to get one.
# Only needed if any model uses the native Claude path (bare id, no "/").
# When everything routes through 9router (recommended), this is optional.
CLAUDE_CODE_OAUTH_TOKEN=

# GitHub token — the planner/merger read & manage GitHub Issues with it.
# Fine-grained token: https://github.com/settings/personal-access-tokens/new
# Permissions: Issues (Read & write) + Metadata (Read) on the target repo.
GH_TOKEN=

# ── Project layout ───────────────────────────────────────────────────────
# Subdirectory holding the pnpm workspace (package.json), relative to repo root.
# Leave empty if the workspace IS the repo root.
# Example: apps/web  (leave empty if the repo root is the workspace)
WORKSPACE_DIR=

# How agents run checks is derived from WORKSPACE_DIR. That default is generic —
# write .sandcastle/workspace-hint.md (markdown, no placeholders) to replace it
# with this repo's real layout and script names. Worth doing: an agent that runs
# `pnpm test` where there are no tests gets exit 0 and reports a green build.

# GitHub label the planner filters issues by (your "ready for the agent" signal).
ISSUE_LABEL=ready-for-agent

# Optional: a file listing the authoritative build/dependency order (e.g. a
# sprint-status.yaml or roadmap doc). Leave empty if you don't have one — the
# planner then orders by each issue's body + labels alone.
# Example: docs/roadmap.md  or  planning/sprint-status.yaml
DEP_ORDER_FILE=

# ── Model routing (all via 9router; ids need a prefix: cc/… ag/… kimi/…) ──
# Everything routes through 9router — your subscription licenses live there, so
# every model (claude/gemini/kimi) is covered. The 9router key is auto-read from
# ~/.9router/auth/cli-secret; nothing to add here. See MODELS.md.
#
# Defaults (uncomment to override):
#   PLAN / REVIEW / MERGE = cc/claude-opus-5   (reasoning + QC)
#   IMPL small (easy)     = ag/gemini-3.1-pro-low
#   IMPL large (hard)     = kimi/kimi-k3
# The planner tags each issue small/large; the implementer model follows, with
# automatic fallback to the sibling tier if one model is offline on 9router.
# MODEL_PLAN=cc/claude-opus-5
# MODEL_REVIEW=cc/claude-opus-5
# MODEL_MERGE=cc/claude-opus-5
# MODEL_IMPL_SMALL=ag/gemini-3.1-pro-low
# MODEL_IMPL_LARGE=kimi/kimi-k3

# Override the 9router gateway URL / key if not using the defaults:
# R9_URL=http://host.docker.internal:20128
# R9_KEY=

# Optional: selection rules only this project knows (finished epics, work blocked
# on someone outside the repo, deferred stories). Write .sandcastle/planning-rules.md
# — it is appended to the planner prompt and survives a harness re-sync.

# How many issues the planner may take per round (parallelism dial). Each issue
# runs an implementer + reviewer in its own sandbox. Default 3.
# BATCH_SIZE=5

# Command the sandbox runs once before the agent starts. Default assumes pnpm
# (what the shipped Dockerfile installs). npm/yarn/bun projects override it here
# instead of editing main.mts, which a harness re-sync would overwrite.
# INSTALL_CMD=npm ci

# Seconds to wait before re-running an issue whose every model was rate-limited.
# Provider windows are short (1-5 min); losing an issue to one is pure waste.
# RATE_LIMIT_WAIT_S=90
